    "output": {
      "public": ["facets", "sc", "regionId", "postalCode", "country"],
      "storefront-permissions": [
        "storeUserId",
        "storeUserEmail",
        "organization",
        "costcenter",
        "costCenterAddressId",
        "priceTables",
        "collections",
        "userId",
        "hash"
      ]
    }
  }
}
