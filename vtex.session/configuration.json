{
  "storefront-permissions": {
    "input": {
      "authentication": ["storeUserEmail", "storeUserId"],
      "checkout": ["orderFormId"],
      "impersonate": ["storeUserEmail", "storeUserId"],
      "public": [
        "impersonate",
        "removeB2B",
        "b2bCurrentCostCenter",
        "costCenterAddressId",
        "allowRegionOverwrite",
        "postalCode",
        "country"
      ],
      "storefront-permissions": ["hash", "organization", "costcenter"]
